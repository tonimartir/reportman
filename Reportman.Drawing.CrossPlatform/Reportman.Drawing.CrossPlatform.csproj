<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

	<PropertyGroup>
		<PackageId>Reportman.Drawing.CrossPlatform</PackageId>
		<Version>3.9.15</Version>
		<Authors>Toni Martir</Authors>
		<Company>Reportman</Company>
		<Description>Reportman, Cross-Platform PDF Output, using FreeType and SkiaSharp.</Description>
		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/tonimartir/reportman</RepositoryUrl>
		<PackageProjectUrl>https://reportman.es</PackageProjectUrl>
		<PackageReleaseNotes>Initial release</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
    <PackageReference Include="FreeTypeSharp" Version="3.0.0" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.2" />
    <PackageReference Include="icu.net" Version="3.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reportman.Drawing\Reportman.Drawing.csproj" />
  </ItemGroup>

  <!--
    FreeType for Android. FreeTypeSharp brings the managed binding and (in its .aar) old,
    unstripped, 4 KB-page native libraries; and its linux-x64 (glibc) build leaks into the
    Android APK through the RID graph. These two are ours: FreeType 2.13.3 built with the
    NDK (tools/android-native/build-freetype.sh), stripped, 16 KB pages, no zlib/png/
    harfbuzz/brotli. NuGet consumers get them as runtimes/android-*/native; an Android app that
    references this PROJECT declares them as AndroidNativeLibrary (project outputs are not
    RID-resolved) and excludes the package natives (see ReportmanFiscal Terminal.Droid.csproj).
  -->
  <ItemGroup>
    <Content Include="native\android\arm64-v8a\libfreetype.so"
             Link="runtimes\android-arm64\native\libfreetype.so"
             CopyToOutputDirectory="PreserveNewest" Pack="true"
             PackagePath="runtimes\android-arm64\native\libfreetype.so" />
    <Content Include="native\android\x86_64\libfreetype.so"
             Link="runtimes\android-x64\native\libfreetype.so"
             CopyToOutputDirectory="PreserveNewest" Pack="true"
             PackagePath="runtimes\android-x64\native\libfreetype.so" />
  </ItemGroup>

</Project>
