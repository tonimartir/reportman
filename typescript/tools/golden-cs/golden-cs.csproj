<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reference outputs of the C# engine for the TypeScript port: the report model as the designer's
    camelCase JSON, expression results, and the metafile (as JSON) and PDF of a run measured with
    the standard 14 PDF fonts. Test tooling only; it is not part of any npm package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>golden-cs</AssemblyName>
    <RootNamespace>Reportman.TypeScriptGolden</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Reportman.Reporting\Reportman.Reporting.csproj" />
    <ProjectReference Include="..\..\..\Reportman.Drawing.CrossPlatform\Reportman.Drawing.CrossPlatform.csproj" />
    <ProjectReference Include="..\..\..\Reportman.Reporting.Design.Json\Reportman.Reporting.Design.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- The providers Reportman.Server registers (DirectProviders.cs), same versions -->
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.2" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <!-- ICU for the bidi of the FreeType driver on Windows, as Reportman.Server -->
    <PackageReference Include="Icu4c.Win.Min" Version="59.1.7" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

</Project>
