# Reports and PDFs are compared byte for byte with the C# engine: never convert their line ends.
*.rep binary
*.pdf binary
*.rpmf binary
# The documents of the Delphi and C# engines the export tests compare byte for byte (CSV with the
# CR LF of C#, SVG and HTML as Delphi writes them)
packages/reportman-export/test/fixtures/** binary
# The XML the Delphi engine writes for the DFM reports @reportman/dfm converts, compared byte for byte
packages/reportman-dfm/test/cases/** binary
packages/reportman-dfm/test/fixtures/** binary
# What the C# engine writes, compared byte for byte by the tests of the .rep writer
packages/reportman-lib/test/fixtures/writer/** binary
