{
  "name": "@reportman/server",
  "version": "4.1.0-alpha.4",
  "description": "Report Manager server for Node.js: the reports API of Reportman.Server (list, parameters, execute to PDF, metafile, text or CSV) over folders of .rep files, and its console (connections, aliases, API keys, sample reports, API explorer).",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonimartir/reportman.git",
    "directory": "typescript/packages/reportman-server"
  },
  "homepage": "https://reportman.es",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "reportman-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "samples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@reportman/node": "4.1.0-alpha.4",
    "@reportman/engine": "4.1.0-alpha.4",
    "@reportman/lib": "4.1.0-alpha.4",
    "@reportman/export": "4.1.0-alpha.4",
    "@reportman/metafile": "4.1.0-alpha.4"
  },
  "scripts": {
    "prepack": "node scripts/copy-samples.mjs"
  },
  "peerDependencies": {
    "@reportman/driver-postgres": "4.1.0-alpha.4",
    "@reportman/driver-firebird": "4.1.0-alpha.4",
    "@reportman/driver-mysql": "4.1.0-alpha.4",
    "@reportman/driver-mssql": "4.1.0-alpha.4",
    "@reportman/driver-http": "4.1.0-alpha.4"
  },
  "peerDependenciesMeta": {
    "@reportman/driver-postgres": {
      "optional": true
    },
    "@reportman/driver-firebird": {
      "optional": true
    },
    "@reportman/driver-mysql": {
      "optional": true
    },
    "@reportman/driver-mssql": {
      "optional": true
    },
    "@reportman/driver-http": {
      "optional": true
    }
  }
}
