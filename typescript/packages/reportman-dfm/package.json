{
  "name": "@reportman/dfm",
  "version": "4.1.0-alpha.2",
  "description": "Report Manager DFM to XML converter: reads a .rep saved by Delphi in its DFM forms (text, binary, compressed) and gives the XML the Delphi engine writes for it, which @reportman/lib reads.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonimartir/reportman.git",
    "directory": "typescript/packages/reportman-dfm"
  },
  "homepage": "https://reportman.es",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "reportman-dfm2xml": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
