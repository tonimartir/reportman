{
  "name": "reportman-node",
  "version": "0.0.1",
  "private": true,
  "description": "Report Manager for Node.js: open a .rep, describe its parameters, run it to PDF.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonimartir/reportman",
    "directory": "typescript/packages/reportman-node"
  },
  "homepage": "https://reportman.es",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "reportman-lib": "0.0.1",
    "reportman-metafile": "0.0.1",
    "reportman-text": "0.0.1",
    "reportman-pdf": "0.0.1",
    "reportman-engine": "0.0.1"
  },
  "bin": {
    "reportman-pdf": "./dist/cli.js"
  }
}
