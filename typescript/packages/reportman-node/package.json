{
  "name": "@reportman/node",
  "version": "4.1.0-alpha.4",
  "description": "Report Manager for Node.js: open a .rep, describe its parameters, run it to PDF.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonimartir/reportman.git",
    "directory": "typescript/packages/reportman-node"
  },
  "homepage": "https://reportman.es",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@reportman/lib": "4.1.0-alpha.4",
    "@reportman/metafile": "4.1.0-alpha.4",
    "@reportman/text": "4.1.0-alpha.4",
    "@reportman/pdf": "4.1.0-alpha.4",
    "@reportman/engine": "4.1.0-alpha.4"
  },
  "bin": {
    "reportman-pdf": "dist/cli.js"
  },
  "peerDependencies": {
    "@reportman/dfm": "4.1.0-alpha.4"
  },
  "peerDependenciesMeta": {
    "@reportman/dfm": {
      "optional": true
    }
  }
}
